<?xml version="1.0" encoding="UTF-8"?>
<!--
  TCDD Railway Map  -  SAP Lumira Designer 2.4 (Design Studio) SDK component
  ===========================================================================
  Dependency-free, Canvas based railway analytics map. No Google Maps / Leaflet
  / API key. Every measure in the bound data source becomes a toggleable layer
  distributed over the railway segments (join: segment dimension key <-> network
  feature id). Network input: GeoJSON / TopoJSON / KML / GPX / plain JSON.
  Symbology: colour ramp / graduated classes / categorical / width.
  Every property carries a Turkish tooltip; on the map, hovering a segment lists
  every measure value.
-->
<sdkExtension xmlns="http://www.sap.com/bi/zen/sdk"
	id="com.tcdd.railmap"
	title="TCDD Railway Map" version="1.0"
	vendor="TCDD">

	<component id="RailwayMap" title="Railway Map" group="TcddMaps"
		icon="res/icon.png" handlerType="div" databound="true" modes="commons m"
		tooltip="Katmanlı demiryolu ağı haritası; ölçüleri hat kesimi bazında renklendirir, sınıflandırır, etiketler.">

		<jsInclude>res/js/railmap-core.js</jsInclude>
		<jsInclude>res/js/component.js</jsInclude>

		<!-- ============================ 1 - VERİ ======================= -->
		<property id="data" title="Data Source" type="ResultCellList" group="1 - Veri"
			tooltip="Veri kaynağını bağlayın. Satırlarda hat kesim boyutu, sütunlarda bir/çok ölçü olsun. Her ölçü ayrı bir katmana dönüşür." />
		<property id="segmentDimension" title="Segment Dimension (technical name)" type="String" group="1 - Veri"
			tooltip="Hat kesim boyutunun TEKNİK adı. Üye anahtarı (key) ağdaki Segment Id ile eşleşir. Boş = ilk ölçü-olmayan boyut." />
		<property id="aggregate" title="Aggregation (last/sum/avg/min/max/count)" type="String" group="1 - Veri"
			tooltip="Aynı hat kesimine birden çok satır düşerse değerlerin nasıl birleştirileceği: last, sum, avg, min, max, count." />
		<property id="dataB" title="Data Source B" type="ResultCellList" group="1 - Veri"
			tooltip="Ek/bağımsız veri kaynağı B. Ana kaynaktan FARKLI bir data source da bağlayabilirsiniz; ölçüleri ayrı katman(lar) olur." />
		<property id="dataC" title="Data Source C" type="ResultCellList" group="1 - Veri"
			tooltip="Ek/bağımsız veri kaynağı C." />
		<property id="dataD" title="Data Source D" type="ResultCellList" group="1 - Veri"
			tooltip="Ek/bağımsız veri kaynağı D." />
		<property id="bindConfig" title="Binding Config (JSON: B/C/D)" type="ScriptText" group="1 - Veri"
			tooltip="Data B/C/D slotları için ayar. Örn: {B:{title:Bütçe, segDim:ZHATKESIM, ramp:blue, type:bubble}, C:{title:Geçen Yıl, ramp:gray}}" />

		<!-- ============================ 2 - AĞ ========================= -->
		<property id="networkUrl" title="Network Source URL" type="String" group="2 - Ağ"
			tooltip="Ağ dosyasının adresi (GeoJSON/TopoJSON/KML/GPX/JSON). Örn: https://bopwin.tcdd.gov.tr/convertedson.json" />
		<property id="networkFormat" title="Network Format" type="String" group="2 - Ağ"
			tooltip="Ağ formatı: auto (otomatik algıla), geojson, topojson, kml, gpx, json." />
		<property id="networkGeoJson" title="Network (inline)" type="ScriptText" group="2 - Ağ"
			tooltip="Ağı doğrudan metin olarak gömün (her format). URL/CORS sorunluysa veya offline için idealdir." />
		<property id="segmentIdProperty" title="Segment Id Property" type="String" group="2 - Ağ"
			tooltip="Feature içinde hat kesimini tanımlayan alan (TCDD verisinde: Hat_kesim). Veri kaynağı üye anahtarıyla eşleşir." />
		<property id="segmentNameProperty" title="Segment Name Property" type="String" group="2 - Ağ"
			tooltip="Hat kesiminin okunabilir adını taşıyan alan (TCDD verisinde: Tanim). Tooltip/etiket/seçimde kullanılır." />

		<!-- ========================= 3 - KATMANLAR ===================== -->
		<property id="baseLayerTitle" title="Base Layer Title" type="String" group="3 - Katmanlar"
			tooltip="En alttaki tüm ağ (taban) katmanının adı." />
		<property id="baseLayerVisible" title="Base Layer Visible" type="boolean" group="3 - Katmanlar"
			tooltip="Taban ağ katmanı başlangıçta görünür mü?" />
		<property id="layerColors" title="Layer Color Ramps (csv)" type="String" group="3 - Katmanlar"
			tooltip="Ölçü katmanlarına sırayla atanacak renk rampaları: traffic, rdylgn, blue, green, heat, purple, viridis, cool, gray." />
		<property id="visibleLayers" title="Visible Layers (csv, blank=first)" type="String" group="3 - Katmanlar"
			tooltip="Başlangıçta görünür ölçü başlıkları (virgülle). Boş = yalnızca ilk ölçü." />
		<property id="showLayerControl" title="Show Layer Control" type="boolean" group="3 - Katmanlar"
			tooltip="Sağ üstteki katman kontrolünü göster." />
		<property id="layerControlCollapsed" title="Collapse Layer Control" type="boolean" group="3 - Katmanlar"
			tooltip="Katman kontrolünü kapalı (dropdown) başlat." />
		<property id="layerControlTitle" title="Layer Control Title" type="String" group="3 - Katmanlar"
			tooltip="Katman kontrolünün başlığı." />
		<property id="layerControlMode" title="Layer Control Mode (checkbox/radio/dropdown)" type="String" group="3 - Katmanlar"
			tooltip="checkbox = çoklu seçim; radio = tek aktif ölçü; dropdown = açılır listeden aktif ölçü." />

		<!-- ========================= 4 - SEMBOL ======================== -->
		<property id="symbology" title="Symbology (ramp/graduated/categorical/width)" type="String" group="4 - Sembol"
			tooltip="ramp = sürekli renk; graduated = sınıflı renk; categorical = ayrık değer renkleri; width = değere göre çizgi kalınlığı." />
		<property id="classMethod" title="Class Method (quantile/equal/jenks)" type="String" group="4 - Sembol"
			tooltip="graduated için sınıflandırma yöntemi: quantile, equal (eşit aralık), jenks (doğal kırılımlar)." />
		<property id="classCount" title="Class Count" type="int" group="4 - Sembol"
			tooltip="graduated için sınıf sayısı (2-9 önerilir)." />
		<property id="minWidth" title="Min Width (width symbology)" type="int" group="4 - Sembol"
			tooltip="width sembolojisinde en düşük değerin çizgi kalınlığı (piksel)." />
		<property id="maxWidth" title="Max Width (width symbology)" type="int" group="4 - Sembol"
			tooltip="width sembolojisinde en yüksek değerin çizgi kalınlığı (piksel)." />
		<property id="layerConfig" title="Per-layer Config (JSON)" type="ScriptText" group="4 - Sembol"
			tooltip="Ölçü bazında ayar JSON. Örn: {Tonaj:{ramp:heat, type:bubble, symbology:graduated, classMethod:jenks, classCount:6, arrows:true, flow:true, labels:true, opacity:80}}" />
		<property id="layerType" title="Layer Type (line/point/marker/bubble/heatmap)" type="String" group="4 - Sembol"
			tooltip="Ölçü katmanlarının varsayılan render tipi. Her katman için ayrıca katman kontrolünden veya setLayerType ile değiştirilebilir." />
		<property id="bubbleMinRadius" title="Bubble Min Radius" type="int" group="4 - Sembol" tooltip="Balon (bubble) tipinde en küçük dairenin yarıçapı (px)." />
		<property id="bubbleMaxRadius" title="Bubble Max Radius" type="int" group="4 - Sembol" tooltip="Balon (bubble) tipinde en büyük dairenin yarıçapı (px)." />
		<property id="heatRadius" title="Heatmap Radius" type="int" group="4 - Sembol" tooltip="Isı haritası (heatmap) nokta yarıçapı (px)." />
		<property id="heatRamp" title="Heatmap Ramp" type="String" group="4 - Sembol" tooltip="Isı haritası renk rampası (heat, viridis, blue …)." />
		<property id="showLayerTypeSelector" title="Show Layer Type Selector" type="boolean" group="4 - Sembol" tooltip="Katman kontrolünde her katman için tip seçim kutusu göster." />

		<!-- ====================== 5 - HARİTA GÖRÜNÜMÜ ================== -->
		<property id="initialLat" title="Initial Latitude" type="float" group="5 - Harita Görünümü" tooltip="Başlangıç merkez enlemi." />
		<property id="initialLng" title="Initial Longitude" type="float" group="5 - Harita Görünümü" tooltip="Başlangıç merkez boylamı." />
		<property id="initialZoom" title="Initial Zoom" type="int" group="5 - Harita Görünümü" tooltip="Başlangıç yakınlaştırma (0-19)." />
		<property id="minZoom" title="Min Zoom" type="int" group="5 - Harita Görünümü" tooltip="En düşük yakınlaştırma." />
		<property id="maxZoom" title="Max Zoom" type="int" group="5 - Harita Görünümü" tooltip="En yüksek yakınlaştırma." />
		<property id="fitNetworkOnLoad" title="Fit To Network On Load" type="boolean" group="5 - Harita Görünümü" tooltip="Ağ yüklendiğinde görünümü ağ sınırlarına sığdır." />

		<!-- ====================== 6 - ALTLIK / ARKA PLAN ============== -->
		<property id="basemap" title="Basemap (osm/carto-light/carto-dark/carto-voyager/none/custom)" type="String" group="6 - Altlık"
			tooltip="Hazır altlık seçimi. 'custom' seçilirse Tile Layer URL kullanılır. 'none' = offline düz zemin." />
		<property id="tileUrl" title="Custom Tile URL" type="String" group="6 - Altlık"
			tooltip="Özel XYZ tile şablonu (Basemap=custom iken). Örn: https://{s}.../{z}/{x}/{y}.png" />
		<property id="tileSubdomains" title="Tile Subdomains" type="String" group="6 - Altlık" tooltip="{s} için alt alan adları (a,b,c)." />
		<property id="tileOpacity" title="Tile Opacity (0-100)" type="int" group="6 - Altlık" tooltip="Altlık saydamlığı." />
		<property id="backgroundColor" title="Background Color" type="String" group="6 - Altlık" tooltip="Altlık yokken zemin rengi (#rrggbb)." />

		<!-- ============================ 7 - STİL ======================= -->
		<property id="defaultColor" title="Default Segment Color" type="String" group="7 - Stil" tooltip="Taban ağ çizgi rengi (#rrggbb)." />
		<property id="lineWeight" title="Line Weight" type="int" group="7 - Stil" tooltip="Ölçü katmanı çizgi kalınlığı (piksel)." />
		<property id="baseLineWeight" title="Base Line Weight" type="int" group="7 - Stil" tooltip="Taban/değersiz hat kalınlığı (piksel)." />
		<property id="highlightColor" title="Highlight Color" type="String" group="7 - Stil" tooltip="Seçili hat kesiminin vurgu rengi." />
		<property id="lineCasing" title="Line Casing (halo)" type="boolean" group="7 - Stil" tooltip="Okunabilirlik için çizgi altına beyaz kılıf çiz." />
		<property id="layerOpacity" title="Layer Opacity (0-100)" type="int" group="7 - Stil" tooltip="Ölçü katmanlarının genel saydamlığı." />
		<property id="pointRadius" title="Point Radius" type="int" group="7 - Stil" tooltip="Nokta (istasyon) işaretçi yarıçapı." />

		<!-- ===================== 8 - ETİKET / OK / AKIŞ =============== -->
		<property id="showArrows" title="Direction Arrows" type="boolean" group="8 - Etiket/Ok/Akış" tooltip="Hatlar üzerinde yön okları göster." />
		<property id="arrowSpacing" title="Arrow Spacing (px)" type="int" group="8 - Etiket/Ok/Akış" tooltip="Yön okları arası piksel mesafesi." />
		<property id="flowAnimation" title="Flow Animation" type="boolean" group="8 - Etiket/Ok/Akış" tooltip="Animasyonlu akış (yürüyen kesik çizgi) efekti." />
		<property id="showLabels" title="Show Labels" type="boolean" group="8 - Etiket/Ok/Akış" tooltip="Hat kesimleri üzerine etiket yaz." />
		<property id="labelMode" title="Label Mode (name/id/value)" type="String" group="8 - Etiket/Ok/Akış" tooltip="Etiket içeriği: name (Tanim), id (Hat_kesim) veya value (o an görünen ölçü değeri)." />
		<property id="labelMinZoom" title="Label Min Zoom" type="int" group="8 - Etiket/Ok/Akış" tooltip="Etiketlerin görüneceği en düşük zoom." />

		<!-- ========================= 9 - BİÇİM ========================= -->
		<property id="valueDecimals" title="Value Decimals (-1=auto)" type="int" group="9 - Biçim" tooltip="Sayı ondalık basamağı. -1 = otomatik (B/M/Mr kısaltma)." />
		<property id="valueUnit" title="Value Unit" type="String" group="9 - Biçim" tooltip="Değerlere eklenecek birim (ör. ton, dk)." />
		<property id="thousandSep" title="Thousand Separator" type="boolean" group="9 - Biçim" tooltip="Binlik ayırıcı kullan (ondalık sabitken)." />

		<!-- ===================== 10 - LEGEND / İPUCU ================== -->
		<property id="showLegend" title="Show Legend" type="boolean" group="10 - Legend/İpucu" tooltip="Renk skalası açıklamasını göster (sembolojiye göre uyarlanır)." />
		<property id="legendTitle" title="Legend Title" type="String" group="10 - Legend/İpucu" tooltip="Legend başlığı. Boş = görünen ölçü adı." />
		<property id="showTooltip" title="Show Tooltip" type="boolean" group="10 - Legend/İpucu" tooltip="Hat kesimine gelince bilgi balonu göster." />
		<property id="tooltipShowMeasures" title="Tooltip Shows All Measures" type="boolean" group="10 - Legend/İpucu" tooltip="Tooltipte segmentin tüm ölçü değerlerini renk noktalarıyla listele." />
		<property id="tooltipProperties" title="Tooltip Properties (csv)" type="String" group="10 - Legend/İpucu" tooltip="Tooltipte ek gösterilecek feature özellik adları (virgülle)." />

		<!-- ========================= 11 - ARAYÜZ ====================== -->
		<property id="showToolbar" title="Show Toolbar" type="boolean" group="11 - Arayüz" tooltip="Sol üst araç çubuğu (sığdır / ara / PNG / tam ekran)." />
		<property id="showSearch" title="Show Search" type="boolean" group="11 - Arayüz" tooltip="Araç çubuğunda hat kesimi arama düğmesi." />
		<property id="showScaleBar" title="Show Scale Bar" type="boolean" group="11 - Arayüz" tooltip="Ölçek çubuğunu göster." />
		<property id="showCoordinates" title="Show Coordinates" type="boolean" group="11 - Arayüz" tooltip="İmleç koordinatlarını alt ortada göster." />
		<property id="showZoomControl" title="Show Zoom Control" type="boolean" group="11 - Arayüz" tooltip="+/- yakınlaştırma düğmeleri." />
		<property id="showBasemapControl" title="Show Basemap Control" type="boolean" group="11 - Arayüz" tooltip="Altlık seçim kutusunu göster." />
		<property id="allowUpload" title="Allow File Upload" type="boolean" group="11 - Arayüz" tooltip="Araç çubuğunda dosya yükleme düğmesi ve haritaya sürükle-bırak ile yerel ağ dosyası (GeoJSON/TopoJSON/KML/GPX/JSON) yükleme. Tamamen tarayıcı tarafında, oturum içidir (kaydedilmez)." />
		<property id="uploadMode" title="Upload Mode (layer/base/append)" type="String" group="11 - Arayüz" tooltip="Yüklenen her dosya ne olsun: layer = ayrı yeni katman (varsayılan), base = taban ağı değiştir (ölçüler buna dağılır), append = mevcut tabana ekle." />
		<property id="uiTheme" title="UI Theme (light/dark)" type="String" group="11 - Arayüz" tooltip="Panel teması: light veya dark." />
		<property id="title" title="Title" type="String" group="11 - Arayüz" tooltip="Üst ortada başlık." />
		<property id="subtitle" title="Subtitle" type="String" group="11 - Arayüz" tooltip="Başlık altı alt metin." />

		<!-- ===================== 12 - SEÇİM / ÇIKTI ================== -->
		<property id="selectedSegment" title="Selected Segment" type="String" group="12 - Seçim" tooltip="Son tıklanan hat kesimi id'si (getSelectedSegment)." />
		<property id="selectedSegmentName" title="Selected Segment Name" type="String" group="12 - Seçim" tooltip="Son seçilen hat kesimi adı." />
		<property id="selectedLayer" title="Selected Layer" type="String" group="12 - Seçim" tooltip="Son tıklanan/aç-kapat yapılan katman id'si." />
		<property id="centerLat" title="Center Latitude (output)" type="float" group="12 - Seçim" tooltip="Güncel harita merkez enlemi (onViewChange ile güncellenir)." />
		<property id="centerLng" title="Center Longitude (output)" type="float" group="12 - Seçim" tooltip="Güncel harita merkez boylamı." />
		<property id="currentZoom" title="Current Zoom (output)" type="int" group="12 - Seçim" tooltip="Güncel yakınlaştırma seviyesi." />

		<!-- ========================= 13 - OLAYLAR ===================== -->
		<property id="onSelect" title="on Select" type="ScriptText" group="13 - Olaylar" tooltip="Bir hat kesimine tıklanınca çalışır." />
		<property id="onLayerToggle" title="on Layer Toggle" type="ScriptText" group="13 - Olaylar" tooltip="Bir katman açılıp kapatılınca çalışır." />
		<property id="onDoubleClick" title="on Double Click" type="ScriptText" group="13 - Olaylar" tooltip="Haritada çift tıklanınca çalışır." />
		<property id="onViewChange" title="on View Change" type="ScriptText" group="13 - Olaylar" tooltip="Pan/zoom sonrası (gecikmeli) çalışır; centerLat/Lng/currentZoom güncellenir." />

		<!-- ===================== DEFAULT VALUES ========================= -->
		<initialization>
			<defaultValue property="WIDTH">640</defaultValue>
			<defaultValue property="HEIGHT">440</defaultValue>
			<defaultValue property="segmentIdProperty">Hat_kesim</defaultValue>
			<defaultValue property="segmentNameProperty">Tanim</defaultValue>
			<defaultValue property="networkFormat">auto</defaultValue>
			<defaultValue property="aggregate">last</defaultValue>
			<defaultValue property="baseLayerTitle">Demiryolu Ağı</defaultValue>
			<defaultValue property="baseLayerVisible">true</defaultValue>
			<defaultValue property="layerColors">traffic,blue,rdylgn,heat,purple,viridis</defaultValue>
			<defaultValue property="showLayerControl">true</defaultValue>
			<defaultValue property="layerControlCollapsed">true</defaultValue>
			<defaultValue property="layerControlTitle">Katmanlar</defaultValue>
			<defaultValue property="layerControlMode">checkbox</defaultValue>
			<defaultValue property="symbology">ramp</defaultValue>
			<defaultValue property="classMethod">quantile</defaultValue>
			<defaultValue property="classCount">5</defaultValue>
			<defaultValue property="minWidth">2</defaultValue>
			<defaultValue property="maxWidth">14</defaultValue>
			<defaultValue property="layerType">line</defaultValue>
			<defaultValue property="bubbleMinRadius">4</defaultValue>
			<defaultValue property="bubbleMaxRadius">26</defaultValue>
			<defaultValue property="heatRadius">26</defaultValue>
			<defaultValue property="heatRamp">heat</defaultValue>
			<defaultValue property="showLayerTypeSelector">true</defaultValue>
			<defaultValue property="initialLat">39.2</defaultValue>
			<defaultValue property="initialLng">35.2</defaultValue>
			<defaultValue property="initialZoom">6</defaultValue>
			<defaultValue property="minZoom">2</defaultValue>
			<defaultValue property="maxZoom">18</defaultValue>
			<defaultValue property="fitNetworkOnLoad">true</defaultValue>
			<defaultValue property="basemap">osm</defaultValue>
			<defaultValue property="tileUrl">https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png</defaultValue>
			<defaultValue property="tileSubdomains">a,b,c</defaultValue>
			<defaultValue property="tileOpacity">100</defaultValue>
			<defaultValue property="backgroundColor">#eef2f5</defaultValue>
			<defaultValue property="defaultColor">#5a6b7b</defaultValue>
			<defaultValue property="lineWeight">4</defaultValue>
			<defaultValue property="baseLineWeight">2</defaultValue>
			<defaultValue property="highlightColor">#ff7f0e</defaultValue>
			<defaultValue property="lineCasing">true</defaultValue>
			<defaultValue property="layerOpacity">100</defaultValue>
			<defaultValue property="pointRadius">5</defaultValue>
			<defaultValue property="showArrows">false</defaultValue>
			<defaultValue property="arrowSpacing">90</defaultValue>
			<defaultValue property="flowAnimation">false</defaultValue>
			<defaultValue property="showLabels">false</defaultValue>
			<defaultValue property="labelMode">name</defaultValue>
			<defaultValue property="labelMinZoom">8</defaultValue>
			<defaultValue property="valueDecimals">-1</defaultValue>
			<defaultValue property="valueUnit"></defaultValue>
			<defaultValue property="thousandSep">true</defaultValue>
			<defaultValue property="showLegend">true</defaultValue>
			<defaultValue property="legendTitle"></defaultValue>
			<defaultValue property="showTooltip">true</defaultValue>
			<defaultValue property="tooltipShowMeasures">true</defaultValue>
			<defaultValue property="tooltipProperties"></defaultValue>
			<defaultValue property="showToolbar">true</defaultValue>
			<defaultValue property="showSearch">true</defaultValue>
			<defaultValue property="showScaleBar">true</defaultValue>
			<defaultValue property="showCoordinates">false</defaultValue>
			<defaultValue property="showZoomControl">true</defaultValue>
			<defaultValue property="showBasemapControl">true</defaultValue>
			<defaultValue property="allowUpload">true</defaultValue>
			<defaultValue property="uploadMode">layer</defaultValue>
			<defaultValue property="uiTheme">light</defaultValue>
			<defaultValue property="title"></defaultValue>
			<defaultValue property="subtitle"></defaultValue>
		</initialization>

	</component>
</sdkExtension>
